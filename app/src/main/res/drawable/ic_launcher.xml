<?xml version="1.0" encoding="utf-8"?>
<!-- v1.0.148: app-module override of the Bcore library's unreferenced
     robot-head PNG (same type+name wins at merge time) — now a bitmap
     alias to the app's ORIGINAL logo (@drawable/ic_launcher_orig), so
     any surface that reads @drawable/ic_launcher shows the real logo.
     (v1.0.147 used a vector recreation here; replaced for exactness.) -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/ic_launcher_orig" />
